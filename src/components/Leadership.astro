---
import Sign from './Sign.astro';
import Register from './Register.jsx';
import { executives, divisions, bodies } from '../data/site.js';
import { gasEnabled } from '../lib/gas.js';

const tiers = [
  ['Simpatisan', 'Siapa saja. Dapat membaca forum, hasil Rembuk yang sudah ditutup, dan status aspirasi.'],
  ['Anggota', 'Mendaftar melalui formulir. Dapat memilih dalam Rembuk, mengajukan dan mendukung aspirasi, serta menulis di forum.'],
  ['Relawan penggerak', 'Anggota yang menjalankan tugas, misalnya sebagai moderator forum, pendamping di wilayah, atau pemeriksa fakta.'],
  ['Pengurus', 'Anggota aktif paling sedikit 30 hari yang terpilih dalam Dewan Pimpinan Pusat, pimpinan wilayah, atau Komite Integritas.'],
];

const rights = [
  'Memilih dalam setiap Rembuk serta memilih dan dipilih sebagai pengurus.',
  'Mengajukan dan mendukung aspirasi serta memperoleh jawaban tertulis.',
  'Membaca laporan anggaran, laporan kepatuhan, dan hasil audit.',
  'Mengajukan penarikan mandat bersama 10% anggota.',
  'Menghapus data pribadi kapan saja.',
];

const duties = [
  'Menaati tata tertib forum dan kode etik.',
  'Memakai satu akun saja.',
  'Menjaga kerahasiaan data anggota lain.',
  'Mengikuti paling sedikit satu Rembuk setiap bulan agar tetap tercatat sebagai anggota aktif.',
];

const election = [
  ['Pencalonan terbuka', 'Calon adalah anggota aktif paling sedikit 30 hari dan didukung oleh lima anggota.'],
  ['Masa debat', 'Berlangsung selama 14 hari di forum dan ditutup dengan tanya jawab.'],
  ['Pemungutan suara', 'Berlangsung selama 3 hari secara rahasia dengan pilihan berperingkat.'],
  ['Penghitungan terbuka', 'Hasil dipublikasikan dan diaudit oleh Komite Integritas.'],
  ['Pelantikan', 'Setiap pengurus menerima uraian tugas tertulis yang tidak tumpang tindih.'],
  ['Evaluasi dan penarikan mandat', 'Evaluasi dilakukan setiap tiga bulan. Mandat ditarik apabila diminta 10% anggota dan disetujui dua pertiga suara.'],
];

const signup = [
  ['Mengisi formulir', 'Nama panggilan, kelompok, dan minat isu. NIK dan alamat tidak diminta.'],
  ['Menyetujui kode etik dan penggunaan data', 'Persetujuan diberikan secara tegas dan dapat dicabut kapan saja.'],
  [
    'Verifikasi (pada sistem nyata)',
    'Melalui surel kampus atau pendamping wilayah, lalu menunggu 7 hari sebelum memiliki hak suara untuk mencegah pendaftaran massal. Tahap ini dilewati dalam simulasi.',
  ],
  ['Menerima kartu anggota', 'Kartu digital memuat nomor anggota dan fitur yang dapat digunakan.'],
];

const officerGroups = [
  { label: 'Pengurus harian', cls: 'officers officers--core', list: executives },
  { label: 'Ketua bidang', cls: 'officers', list: divisions },
];
---

<section class="sec sec--white" id="leadership" aria-labelledby="lead-title">
  <div class="wrap wrap--rail">
    <Sign num="03" id="lead-title" title="Leadership & Membership" sub="Susunan pengurus, model kepemimpinan, keanggotaan, dan formulir pendaftaran simulasi." />

    <div class="lead__model">
      <div>
        <h3>Kepemimpinan kolektif kolegial</h3>
        <p>
          Partai Simpul dipimpin Dewan Pimpinan Pusat yang terdiri atas Ketua Umum, Wakil Ketua Umum, Sekretaris Jenderal,
          Bendahara Umum, dan empat ketua bidang. Mereka dipilih anggota melalui pemungutan suara elektronik untuk masa
          jabatan satu tahun, paling lama dua periode berturut-turut. Keputusan pimpinan diambil bersama dan Ketua Umum tidak
          memiliki hak veto. Juru bicara partai bergilir setiap tiga bulan. Keputusan strategis tetap berada di tangan anggota
          melalui Rembuk.
        </p>
      </div>
      <div class="duo">
        <div>
          <h4>Konsekuensi demokratis yang diharapkan</h4>
          <ul class="plain">
            <li>Kekuasaan tidak menumpuk pada satu tokoh.</li>
            <li>Setiap jabatan memiliki uraian tugas tertulis.</li>
            <li>Mandat pengurus dapat ditarik apabila diminta 10% anggota dan disetujui dua pertiga suara.</li>
          </ul>
        </div>
        <div>
          <h4>Kelemahan dan cara mengatasinya</h4>
          <ul class="plain">
            <li>Keputusan dapat berjalan lebih lambat. Karena itu, usulan yang mencapai ambang diberi batas 7 hari dan tersedia jalur cepat untuk keadaan mendesak.</li>
            <li>Tanggung jawab dapat menjadi kabur. Karena itu, setiap pengurus memegang satu bidang keputusan.</li>
            <li>Kepemimpinan kolektif belum tentu demokratis. Karena itu, Komite Integritas mengaudit proses pengambilan keputusan, tidak hanya hasilnya.</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="org">
      <h3>Bagan organisasi</h3>
      <ul class="tree">
        <li>
          <div class="node node--root">
            <strong>Majelis Anggota</strong>
            <span>Seluruh anggota aktif sebagai pemegang kedaulatan tertinggi. Memutuskan dalam Rembuk, memilih pengurus, dan menarik mandat.</span>
          </div>
          <ul>
            <li>
              <div class="node node--dpp">
                <strong>Dewan Pimpinan Pusat</strong>
                <span>Pimpinan kolektif kolegial yang menjalankan keputusan Rembuk. Seluruh jabatan di bawah ini adalah anggotanya.</span>
                {
                  officerGroups.map((g) => (
                    <div class="officers__group">
                      <p class="officers__label">{g.label}</p>
                      <ul class={g.cls}>
                        {g.list.map((c) => (
                          <li>
                            <div class="node">
                              <p class="seat__head">
                                <strong>{c.seat}</strong>
                                {c.name && <span class="seat__name">{c.name}</span>}
                              </p>
                              <p>{c.duty}</p>
                              {c.role && <p class="seat__role">Peran proyek: {c.role}</p>}
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </li>
            <li>
              <div class="node">
                <strong>Dewan Pimpinan Wilayah</strong>
                <span>Pengurus Simpul Wilayah bersama relawan. Menyediakan titik akses dan pendamping bagi anggota yang kesulitan memakai platform.</span>
              </div>
            </li>
            {
              bodies.map((b) => (
                <li>
                  <div class="node">
                    <p class="seat__head">
                      <strong>{b.body}</strong>
                      {b.name && <span class="seat__name">{b.name}</span>}
                    </p>
                    <span>{b.duty}</span>
                    <span class="seat__role">Peran proyek: {b.role}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </li>
      </ul>
    </div>

    <div class="lead__pair">
      <div>
        <h3>Jenjang keanggotaan</h3>
        <ol class="route route--v">
          {
            tiers.map((t) => (
              <li>
                <strong>{t[0]}</strong>
                <span>{t[1]}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="duo duo--stack">
        <div>
          <h3>Hak anggota</h3>
          <ul class="plain">
            {rights.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <div>
          <h3>Kewajiban anggota</h3>
          <ul class="plain">
            {duties.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="lead__pair">
      <div>
        <h3>Tata cara pemilihan pengurus</h3>
        <ol class="route route--v">
          {
            election.map((e) => (
              <li>
                <strong>{e[0]}</strong>
                <span>{e[1]}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3>Pendaftaran anggota digital</h3>
        <ol class="route route--v">
          {
            signup.map((e) => (
              <li>
                <strong>{e[0]}</strong>
                <span>{e[1]}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="member-zone" id="membership">
      <div class="member-zone__intro">
        <h3>Daftar sebagai anggota simulasi</h3>
        <p>
          Isi formulir singkat, lalu kartu anggota digital langsung terbit. Dengan kartu ini Anda dapat memilih, mendukung
          aspirasi, dan menulis di forum pada bagian Digital Participation.
        </p>
        <p>
          {
            gasEnabled()
              ? 'Formulir ini hanya simulasi dan tidak meminta surel, NIK, atau alamat. Nama panggilan, kelompok, dan isu yang Anda pilih disimpan di Google Spreadsheet panitia dan dapat Anda hapus kapan saja melalui tombol Hapus data saya.'
              : 'Formulir ini hanya simulasi dan tidak meminta surel, NIK, atau alamat. Data Anda tidak keluar dari peramban ini.'
          }
        </p>
      </div>
      <div class="member-zone__tool">
        <Register client:only="react">
          <p slot="fallback" class="loading">Memuat formulir pendaftaran...</p>
        </Register>
        <noscript>
          <p class="loading">Formulir membutuhkan JavaScript. Aktifkan JavaScript untuk mencoba pendaftaran.</p>
        </noscript>
      </div>
    </div>
  </div>
</section>
