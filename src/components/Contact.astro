---
import Sign from './Sign.astro';
import { social } from '../data/site.js';
import { gasEnabled } from '../lib/gas.js';

const terms = [
  ['Simulasi akademik', 'Partai Simpul fiktif dan tidak berafiliasi dengan partai politik mana pun.'],
  [
    'Data',
    gasEnabled()
      ? 'Nama panggilan, kelompok, dan isu yang dipilih disimpan di Google Spreadsheet panitia agar hasilnya tampil di semua perangkat. Surel, NIK, dan alamat tidak dikumpulkan. Anggota dapat menghapus datanya kapan saja. Situs ini tidak memakai pelacak atau analitik. Peta lokasi dimuat dari OpenStreetMap.'
      : 'Hanya nama panggilan yang disimpan di peramban dan tidak dikirim ke server. Situs ini tidak memakai pelacak atau analitik. Peta lokasi dimuat dari OpenStreetMap.',
  ],
  ['Integritas', 'Tidak ada bot, pembelian pengikut, atau pengaturan hasil pemungutan suara. Semua angka berasal dari suara dan data yang benar-benar masuk.'],
  ['Pengungkapan AI', 'Desain, kode, dan draf konten situs ini dibantu AI (Claude, Anthropic). Tim kelompok meninjau dan bertanggung jawab atas isinya.'],
];
---

<section class="sec sec--dark" id="contact" aria-labelledby="contact-title">
  <div class="wrap wrap--rail">
    <Sign num="07" id="contact-title" title="Contact & Social Media" sub="Akun media sosial proyek dan saluran pengaduan." />

    <div class="contact__grid">
      <div>
        <h3>Media sosial</h3>
        <ul class="socials">
          {
            social.map((s) =>
              s.href ? (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer">
                    <strong>{s.name}</strong>
                    <span class="socials__handle">{s.handle}</span>
                    <span class="socials__use">{s.use}</span>
                    <span class="sr-only">(buka di tab baru)</span>
                  </a>
                </li>
              ) : (
                <li>
                  <div class="socials__ph">
                    <strong>{s.name}</strong>
                    <span class="socials__handle">{s.handle}</span>
                    <span class="socials__use">{s.use}</span>
                    <span class="socials__todo">Tautan akun belum diisi tim.</span>
                  </div>
                </li>
              ),
            )
          }
        </ul>
      </div>

      <div>
        <h3>Saluran pengaduan</h3>
        <p>
          Dugaan penyalahgunaan data, kecurangan pemungutan suara, atau unggahan yang melanggar tata tertib dapat dilaporkan
          melalui Aspirasi dengan kategori Pengaduan integritas atau melalui tombol Laporkan di forum. Komite Integritas akan
          menjawab secara tertulis.
        </p>
        <a class="btn btn--primary" href="#partisipasi-aspirasi">Ajukan pengaduan melalui Aspirasi</a>
      </div>
    </div>

    <div class="terms">
      <h3>Tata tertib situs</h3>
      <dl>
        {
          terms.map((t) => (
            <div>
              <dt>{t[0]}</dt>
              <dd>{t[1]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
