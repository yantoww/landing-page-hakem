---
import Sign from './Sign.astro';
import { news, venue } from '../data/site.js';
import { gasEnabled } from '../lib/gas.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const types = [
  ['semua', 'Semua'],
  ['kegiatan', 'Kegiatan'],
  ['berita', 'Berita'],
  ['materi', 'Materi kampanye'],
];
const label = { kegiatan: 'Kegiatan', berita: 'Berita', materi: 'Materi kampanye' };

const point = `${venue.lat},${venue.lon}`;
const bbox = [venue.lon - 0.0028, venue.lat - 0.0018, venue.lon + 0.0028, venue.lat + 0.0018].map((n) => n.toFixed(5)).join(',');
const mapEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bbox)}&layer=mapnik&marker=${encodeURIComponent(point)}`;
const mapGoogle = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(point)}`;
const mapOsm = `https://www.openstreetmap.org/?mlat=${venue.lat}&mlon=${venue.lon}#map=18/${venue.lat}/${venue.lon}`;
---

<section class="sec" id="news" aria-labelledby="news-title">
  <div class="wrap wrap--rail">
    <Sign num="06" id="news-title" title="News & Activities" sub="Kegiatan, berita, materi kampanye, dan lokasi pameran Partai Simpul." />

    <div class="filter" role="group" aria-label="Filter jenis informasi">
      {
        types.map(([k, l]) => (
          <button type="button" class="chip" data-filter={k} aria-pressed={k === 'semua' ? 'true' : 'false'}>
            {l}
          </button>
        ))
      }
    </div>

    <ul class="news">
      {
        news.map((n) => (
          <li class={n.featured ? 'ncard ncard--feat' : 'ncard'} data-type={n.type}>
            <img src={`${base}/${n.image}`} alt="" width="1200" height="800" loading="lazy" />
            <div class="ncard__body">
              <p class="ncard__tag">{label[n.type]}, {n.date}</p>
              <h3>{n.title}</h3>
              <p>{n.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="posters" data-type="materi">
      <h3>Materi kampanye</h3>
      <div class="posters__row">
        <figure class="poster poster--a">
          <div class="poster__art">
            <img src={`${base}/logo.svg`} alt="" width="56" height="56" />
            <p class="poster__big">Politik yang ikut Anda <em>tentukan.</em></p>
            <p class="poster__small">Terhubung, Berembuk, Memutuskan</p>
          </div>
          <figcaption>Poster slogan. Materi kampanye simulasi.</figcaption>
        </figure>

        <figure class="poster poster--b">
          <div class="poster__art">
            <p class="poster__big">Satu anggota, satu suara.</p>
            <ul class="poster__rules">
              <li>Kuorum 30% anggota aktif</li>
              <li>{gasEnabled() ? 'Suara tanpa nama' : 'Suara rahasia'}</li>
              <li>Hasil terbuka untuk umum</li>
            </ul>
            <p class="poster__small">Partai Simpul, simulasi akademik</p>
          </div>
          <figcaption>Poster aturan suara. Materi kampanye simulasi.</figcaption>
        </figure>

        <figure class="poster poster--c">
          <div class="poster__art">
            <p class="poster__big">Dari aspirasi ke keputusan</p>
            <ol class="route route--v route--mini">
              <li><strong>Diajukan</strong></li>
              <li><strong>25 dukungan</strong><span>dikaji dalam 7 hari</span></li>
              <li><strong>100 dukungan</strong><span>wajib masuk agenda Rembuk</span></li>
              <li><strong>Rembuk</strong><span>diputuskan dengan kuorum</span></li>
            </ol>
          </div>
          <figcaption>Infografik alur aspirasi. Materi kampanye simulasi.</figcaption>
        </figure>
      </div>
    </div>

    <p class="empty" id="news-empty" hidden>Belum ada isi untuk kategori ini.</p>

    <div class="venue">
      <div class="venue__info">
        <h3>Lokasi pameran</h3>
        <p><strong>{venue.name}</strong></p>
        <address>{venue.address}</address>
        <p class="venue__coord">Koordinat: <span class="num">{venue.lat.toFixed(5)}, {venue.lon.toFixed(5)}</span></p>
        <div class="actions">
          <a class="btn btn--primary" href={mapGoogle} target="_blank" rel="noopener noreferrer">
            Buka di Google Maps<span class="sr-only"> (buka di tab baru)</span>
          </a>
          <a class="btn btn--ghost" href={mapOsm} target="_blank" rel="noopener noreferrer">
            Lihat di OpenStreetMap<span class="sr-only"> (buka di tab baru)</span>
          </a>
        </div>
      </div>
      <iframe class="venue__map" title={`Peta lokasi ${venue.name}`} src={mapEmbed} loading="lazy"></iframe>
    </div>
  </div>
</section>

<script>
  const chips = document.querySelectorAll('.chip[data-filter]');
  const items = document.querySelectorAll('#news [data-type]'); // peta lokasi tidak ikut disaring
  const empty = document.getElementById('news-empty');

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      items.forEach((el) => {
        const hide = f !== 'semua' && el.dataset.type !== f;
        el.hidden = hide;
        if (!hide) shown++;
      });
      empty.hidden = shown > 0;
    }),
  );
</script>
