---
import Sign from './Sign.astro';
import { gasEnabled } from '../lib/gas.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const problems = [
  {
    t: 'Proses keputusan partai jarang terlihat.',
    d: 'Warga hanya melihat hasil akhirnya, misalnya koalisi dan sikap partai, tanpa mengetahui siapa yang memutuskan dan apa dasarnya.',
  },
  {
    t: 'Keanggotaan sering hanya formalitas.',
    d: 'Anggota diminta hadir dalam kampanye, tetapi tidak memiliki hak yang jelas untuk menentukan arah partai.',
  },
  {
    t: 'Teknologi lebih banyak dipakai untuk kampanye.',
    d: 'Akun media sosial partai ramai, sedangkan forum internal dan proses pengambilan keputusan tetap tertutup.',
  },
];

const mission = [
  'Menjadikan suara anggota sebagai dasar keputusan strategis dengan aturan kuorum, suara terbanyak, dan batas waktu tindak lanjut yang tertulis.',
  'Menjalankan kepemimpinan kolektif kolegial dengan masa jabatan terbatas dan mandat yang dapat ditarik anggota.',
  'Memperjuangkan tiga agenda: kerja layak di ekonomi platform, anggaran terbuka, dan hak digital.',
  'Mengelola data anggota seperlunya dan membuka aturan platform untuk diaudit Komite Integritas.',
  'Memberi ruang bagi kelompok yang jarang terwakili, termasuk warga yang sulit menghadiri rapat tatap muka.',
];

const compare = [
  [
    'Keputusan strategis',
    'Diputuskan pengurus pusat, lalu disampaikan kepada anggota.',
    'Diputuskan anggota melalui pemungutan suara dengan aturan kuorum dan suara terbanyak.',
  ],
  [
    'Keanggotaan',
    'Anggota memiliki kartu, tetapi hak suara sering terbatas pada kongres.',
    'Pendaftaran daring tanpa biaya dan hak suara dalam setiap Rembuk Pekanan.',
  ],
  [
    'Kepemimpinan',
    'Ketua umum memegang wewenang yang besar.',
    'Dewan Pimpinan Pusat bekerja secara kolektif kolegial, Ketua Umum tanpa hak veto, dan mandat dapat ditarik anggota.',
  ],
  [
    'Transparansi',
    'Laporan disampaikan secara berkala.',
    'Hasil suara, status aspirasi, dan catatan moderasi dapat dilihat langsung.',
  ],
  [
    'Data anggota',
    'Dikelola sekretariat dan aturan aksesnya jarang dipublikasikan.',
    gasEnabled()
      ? 'Data dikumpulkan seperlunya, dapat dihapus, dan catatan suara hanya memakai nomor anggota acak.'
      : 'Data dikumpulkan seperlunya, dapat dihapus, dan kotak suara dipisahkan dari identitas.',
  ],
];

const values = [
  ['Keterbukaan', 'Aturan, hasil, dan alasan keputusan dapat dibaca siapa saja.'],
  ['Kesetaraan suara', 'Tidak ada suara yang bernilai lebih tinggi karena jabatan atau iuran.'],
  ['Akuntabilitas', 'Setiap pengurus memiliki uraian tugas tertulis dan mandatnya dapat ditarik.'],
  ['Kedaulatan data', 'Anggota berkuasa atas data pribadinya dan dapat menghapusnya kapan saja.'],
];

const represented = [
  'Pemilih pemula dan mahasiswa.',
  'Pekerja platform, seperti pengemudi, kurir, pekerja lepas, dan kreator konten.',
  'Pelaku UMKM digital.',
  'Warga yang sulit hadir di rapat tatap muka karena jarak, jam kerja, atau disabilitas.',
];

const meaning = [
  [
    'Nama',
    'Simpul berarti ikatan sekaligus titik pertemuan jalur, seperti simpul transportasi. Setiap anggota merupakan satu simpul, dan keputusan lahir di titik pertemuan.',
  ],
  [
    'Logo',
    'Tiga garis bertemu pada satu lingkaran. Warna kuning mewakili aspirasi, biru muda mewakili forum, dan putih mewakili pemungutan suara. Garis yang keluar melambangkan keputusan yang ditetapkan.',
  ],
  [
    'Warna',
    'Nila (biru tua), warna celup tradisional, melambangkan ketelitian. Kunyit (kuning) dipakai khusus untuk ajakan utama. Putih melambangkan keterbukaan.',
  ],
  [
    'Slogan',
    'Terhubung, Berembuk, Memutuskan menggambarkan urutan kerja partai, yaitu mengumpulkan usulan, membahasnya bersama, lalu memutuskannya dengan aturan tertulis.',
  ],
];
---

<section class="sec" id="about" aria-labelledby="about-title">
  <div class="wrap wrap--rail">
    <Sign num="02" id="about-title" title="About Us" sub="Latar belakang, visi dan misi, ideologi, dan makna identitas Partai Simpul." />

    <div class="about__top">
      <div class="about__why">
        <h3>Mengapa Simpul didirikan</h3>
        <ol class="route route--v">
          {
            problems.map((p) => (
              <li>
                <strong>{p.t}</strong>
                <span>{p.d}</span>
              </li>
            ))
          }
        </ol>
        <p class="note">
          Kajian tentang partai digital (Gerbaudo, 2018; Barberà dkk., 2021) mencatat bahwa platform dapat memperluas partisipasi
          anggota, tetapi juga dapat memusatkan kekuasaan pada pemimpin dan pemilik platform. Karena itu, Partai Simpul menetapkan
          aturannya secara tertulis sejak awal.
        </p>

        <div class="about__block">
          <h3>Ideologi dan orientasi</h3>
          <p>
            Demokrasi partisipatoris berlandaskan Pancasila, terutama sila keempat: kerakyatan yang dipimpin oleh hikmat
            kebijaksanaan dalam permusyawaratan/perwakilan. Kata <em>rembuk</em> (berunding bersama sampai ada kesepakatan)
            diambil dari tradisi itu.
          </p>
          <p>
            Orientasi kebijakannya progresif dan pragmatis. Sikap Partai Simpul ditentukan oleh keputusan anggota dan bukti,
            bukan oleh garis ideologi yang ditetapkan pengurus.
          </p>
        </div>

        <div class="about__block">
          <h3>Kelompok yang diwakili</h3>
          <ul class="plain">
            {represented.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>

      <div class="about__vision">
        <h3>Visi</h3>
        <p class="vision">
          Terwujudnya politik Indonesia yang keputusan pentingnya dapat dilihat, diikuti, dan ditentukan oleh anggota melalui
          platform yang terbuka untuk diaudit.
        </p>
        <h3>Misi</h3>
        <ol class="mission">
          {mission.map((m) => <li>{m}</li>)}
        </ol>
      </div>
    </div>

    <div class="about__compare">
      <h3>Perbedaan dengan partai konvensional</h3>
      <table class="stack-table compare">
        <caption>Gambaran umum untuk perbandingan, bukan penilaian atas partai tertentu.</caption>
        <thead>
          <tr>
            <th scope="col">Aspek</th>
            <th scope="col">Pola umum partai konvensional</th>
            <th scope="col">Partai Simpul</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((r) => (
              <tr>
                <th scope="row">{r[0]}</th>
                <td data-label="Pola umum partai konvensional">{r[1]}</td>
                <td data-label="Partai Simpul">{r[2]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <dl class="values">
      {
        values.map((v) => (
          <div>
            <dt>{v[0]}</dt>
            <dd>{v[1]}</dd>
          </div>
        ))
      }
    </dl>

    <div class="identity">
      <img class="identity__logo" src={`${base}/logo.svg`} alt="Logo Partai Simpul: tiga garis bertemu di satu lingkaran" width="220" height="220" />
      <div>
        <h3>Makna identitas</h3>
        <dl class="meaning">
          {
            meaning.map((m) => (
              <div>
                <dt>{m[0]}</dt>
                <dd>{m[1]}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
