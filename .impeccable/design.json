  "narrative": {
    "northStar": "Jalur Simpul (the transit-signage map)",
    "overview": "The page is a route map. Three lines, A (Aspirasi), F (Forum) and S (Suara), converge on one interchange where member input becomes a decided outcome, and the conversion rule is printed on the board like a station notice. Every surface borrows from way-finding signage: heavy rail strokes, ringed stations, lettered line badges, a commuter-card pass, a service-disruption table and a rubber stamp. Flat, saturated and legible from across a room.\n\nGrounds alternate between pale blue-white paper and full-bleed deep indigo (nila). One warm color, kunyit, is reserved for the single primary action and the \"you are here\" signal. Type is Overpass only, heavy for headings and plain for reading.",
    "keyCharacteristics": [
      "Flat, outlined, signage-like: depth from tone, thick strokes and one soft lift shadow, never hard offsets.",
      "Two grounds in rhythm: light reading areas and full indigo fields.",
      "One action color (kunyit); line colors appear only as badges, map strokes and tab underlines.",
      "Motion is a signal travelling the line."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "Kunyit marks the primary action and the \"you are here\" signal. A screen has one kunyit button; line identity colors are never reused as buttons.",
        "section": "colors"
      },
      {
        "name": "The Cabai Reserve Rule",
        "body": "Cabai appears only for error and the stamp. It never decorates, never marks a line, never fills a section.",
        "section": "colors"
      },
      {
        "name": "The Two Grounds Rule",
        "body": "Reading areas are paper/white/nila-100; hero, participation, rules/risks and footer are full nila-900. White panels inside an indigo field flip focus back to nila-700.",
        "section": "colors"
      },
      {
        "name": "The Sign Face Rule",
        "body": "Overpass only. No second family, no system display face, no italic voice.",
        "section": "typography"
      },
      {
        "name": "The Weight-Not-Case Rule",
        "body": "Hierarchy is made with weight and size. Uppercase is reserved for the stamp (and the decorative pass watermark); never a label style.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "Only floating or physical objects (stuck header, menu, vote card, pass) take --lift. Everything else stays flat.",
        "section": "elevation"
      },
      {
        "name": "The Signal Rule",
        "body": "Motion shows cause: something travels a line to where it matters. Decorative drift, parallax and idle loops are out.",
        "section": "motion"
      },
      {
        "name": "The Gated Start Rule",
        "body": "A hidden from-state exists only under .js and no-preference; without JS or with reduced motion the page is complete and visible.",
        "section": "motion"
      }
    ],
    "dos": [
      "Do use kunyit for exactly one primary action per view and for the current-station signal.",
      "Do keep every control at 44px minimum height (48px default) with a visible 3px focus ring (nila-700 on light, kunyit on dark).",
      "Do build new sections as stations: a ringed bullet, a heavy title, rail on the left at 900px+.",
      "Do express line identity with the A/F/S badge and its fixed color (kunyit, langit, white).",
      "Do keep placeholders labelled: every input has a visible label, and unresolved copy uses the dashed .ph marker.",
      "Do pair text and ground only from the verified contrast list.",
      "Do write motion as transform/opacity/clip-path/stroke-dashoffset, gated by prefers-reduced-motion: no-preference or .js, with IntersectionObserver instead of scroll listeners.",
      "Do keep the mandatory label band, with its single em dash, at the top of every page."
    ],
    "donts": [
      "Don't add kickers, eyebrows or small uppercase label lines above headings.",
      "Don't use icon glyphs or icon fonts; arrows and chevrons are drawn SVG, and signs are circles, letters and strokes.",
      "Don't use hard offset shadows, glows or any shadow other than --lift.",
      "Don't use gradient text or decorative gradients; the only gradient is the pass's hard-stop tri-stripe.",
      "Don't use more than one em dash on the site: the mandatory label is the only one.",
      "Don't put kunyit on white as text or a border, or use cabai for anything but error and the stamp.",
      "Don't use a second typeface or a system display face.",
      "Don't hide text with motion, run infinite loops, or attach scroll listeners.",
      "Don't fall back to the generic party site: a photo hero, three pillar cards, headline statistics."
    ]
  }
}